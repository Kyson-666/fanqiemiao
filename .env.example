# 番茄喵 Web · 环境变量示例
# 复制为 .env 后按需修改（docker compose 会自动读取）

# 对外端口
WEB_PORT=8080

# 访问口令（留空=不校验；公网暴露务必设置）
WEB_PASSWORD=

# ★ 小说文件持久化的宿主机目录（容器内固定为 /downloads）
DOWNLOAD_HOST_DIR=./downloads

# 数据目录（内核配置/日志、库索引、历史、暂存）
DATA_HOST_DIR=./data

# 内核版本与下载加速前缀
KERNEL_VERSION=v2.4.15
KERNEL_MIRROR=https://ghfast.top/
